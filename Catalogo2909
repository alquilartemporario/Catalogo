<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#faf9f5;color:#141413}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Deptos Amoblados Buenos Aires</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Onest:wght@400;500;600&display=swap">
<style>
/* Layout: catálogo — barra de filtros + grilla de fichas agrupadas por zona; ficha abre detalle con galería. Acento jacarandá. */
:root{
  --bg:#F5F4F8; --surface:#FFFFFF; --sunk:#ECEAF2; --ink:#1C1923; --muted:#686274; --line:#E1DDE9;
  --accent:#6743B5; --accent-soft:#EEE8FA; --on-accent:#FFFFFF;
  --wa:#178F48; --wa-ink:#FFFFFF; --ok:#1C7A45; --ok-soft:#E3F3E9; --warn:#8A5A00; --warn-soft:#FBF0DA;
  --shadow:0 1px 2px rgba(28,25,35,.06),0 6px 20px rgba(28,25,35,.06);
  --f-display:"Bricolage Grotesque",ui-sans-serif,system-ui,sans-serif;
  --f-body:"Onest",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
  --r:14px;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#131118; --surface:#1C1922; --sunk:#25212D; --ink:#EEEAF4; --muted:#A49DB2; --line:#322D3C;
  --accent:#B79CF2; --accent-soft:#2C2440; --on-accent:#1A1326;
  --wa:#25C565; --wa-ink:#0B2615; --ok:#6FD49A; --ok-soft:#173424; --warn:#F2C46B; --warn-soft:#3A2D12;
  --shadow:0 1px 2px rgba(0,0,0,.3),0 8px 24px rgba(0,0,0,.25); color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#131118; --surface:#1C1922; --sunk:#25212D; --ink:#EEEAF4; --muted:#A49DB2; --line:#322D3C;
  --accent:#B79CF2; --accent-soft:#2C2440; --on-accent:#1A1326;
  --wa:#25C565; --wa-ink:#0B2615; --ok:#6FD49A; --ok-soft:#173424; --warn:#F2C46B; --warn-soft:#3A2D12;
  --shadow:0 1px 2px rgba(0,0,0,.3),0 8px 24px rgba(0,0,0,.25); color-scheme:dark}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
a{color:inherit}
button,input,select{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.wrap{max-width:1240px;margin:0 auto;padding-inline:clamp(16px,3vw,32px)}

/* top bar */
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:30;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.top .wrap{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-block:10px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;min-width:0}
.brand-mark{width:34px;height:34px;border-radius:9px;background:var(--accent);color:var(--on-accent);display:grid;place-items:center;font:800 15px/1 var(--f-display);flex:none}
.brand>span:last-child{min-width:0;overflow:hidden}
.brand b{font:700 16px/1.1 var(--f-display);display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.brand small{color:var(--muted);font-size:12px;white-space:nowrap}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:999px;padding:10px 16px;font-weight:600;font-size:14px;cursor:pointer;text-decoration:none;white-space:nowrap}
.btn-wa{background:var(--wa);color:var(--wa-ink)}
.btn-wa:hover{filter:brightness(1.07)}
.btn-ghost{background:var(--sunk);color:var(--ink)}
.btn-ghost:hover{background:var(--line)}
.btn svg{width:18px;height:18px;flex:none}

/* hero */
.hero{padding-block:36px 8px;display:grid;gap:18px}
.hero h1{font:800 clamp(30px,5vw,52px)/1.02 var(--f-display);letter-spacing:-.02em;margin:0;text-wrap:balance;max-width:16ch}
.hero h1 em{font-style:normal;color:var(--accent)}
.hero p{margin:0;color:var(--muted);max-width:60ch;font-size:16px}
.facts{display:flex;flex-wrap:wrap;gap:8px 22px;font-size:14px;color:var(--muted)}
.facts strong{font:700 20px/1 var(--f-display);color:var(--ink);margin-right:5px;font-variant-numeric:tabular-nums}

/* colecciones */
.eyebrow{font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:0 0 10px}
.cols{padding-block:22px 6px}
.col-row{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
.col-btn{display:flex;flex-direction:column;align-items:flex-start;gap:2px;text-align:left;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:12px 14px;cursor:pointer;transition:border-color .15s,background .15s}
.col-btn:hover{border-color:var(--accent)}
.col-btn[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
.col-btn[aria-pressed="true"] .n{color:var(--on-accent);opacity:.85}
.col-btn .t{font-weight:600;font-size:14px}
.col-btn .n{font-size:12px;color:var(--muted);font-variant-numeric:tabular-nums}

/* filtros */
.filters{margin-top:18px;background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:16px;display:grid;gap:14px}
.f-toggle{display:none}
.f-body{display:grid;gap:14px}
.f-grid{display:grid;grid-template-columns:2fr repeat(4,minmax(0,1fr));gap:12px}
.field{display:grid;gap:5px;min-width:0}
.field label,.field .lbl{font-size:12px;font-weight:600;color:var(--muted)}
.field input,.field select{width:100%;background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:9px 11px;min-width:0}
.seg{display:flex;background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:3px;gap:2px}
.seg button{flex:1;border:0;background:none;border-radius:7px;padding:6px 4px;font-size:13px;font-weight:600;cursor:pointer;color:var(--muted)}
.seg button[aria-pressed="true"]{background:var(--surface);color:var(--ink);box-shadow:var(--shadow)}
.chips{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.chip{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);background:var(--bg);border-radius:999px;padding:6px 12px;font-size:13px;font-weight:500;cursor:pointer;user-select:none}
.chip input{position:absolute;opacity:0;pointer-events:none}
.chip:has(input:checked){background:var(--accent-soft);border-color:var(--accent);color:var(--ink)}
.chip:has(input:focus-visible){outline:2px solid var(--accent);outline-offset:2px}
.chip .dot{width:14px;height:14px;border-radius:4px;border:1.5px solid var(--muted);display:grid;place-items:center;font-size:10px;line-height:1}
.chip:has(input:checked) .dot{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
.chip:has(input:checked) .dot::after{content:"✓"}
.f-foot{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:10px;border-top:1px solid var(--line);padding-top:12px}
.count{font-size:14px;color:var(--muted)} .count b{color:var(--ink);font-variant-numeric:tabular-nums}
.linkbtn{background:none;border:0;color:var(--accent);font-weight:600;cursor:pointer;padding:4px}

/* zonas nav */
.zones{display:flex;gap:8px;overflow-x:auto;padding-block:18px 4px;scrollbar-width:thin}
.zones a{flex:none;text-decoration:none;font-size:13px;font-weight:600;padding:7px 12px;border-radius:999px;background:var(--sunk);color:var(--ink)}
.zones a:hover{background:var(--accent-soft)}
.zones a span{color:var(--muted);font-weight:500;margin-left:4px}

/* secciones */
.section{padding-block:26px 6px;scroll-margin-top:80px}
.sec-head{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:6px 16px;margin-bottom:14px;border-bottom:1px solid var(--line);padding-bottom:10px}
.sec-head h2{font:700 clamp(22px,3vw,28px)/1.1 var(--f-display);margin:0;letter-spacing:-.01em;text-wrap:balance}
.sec-head p{margin:0;color:var(--muted);font-size:13px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:18px}

/* ficha */
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;display:flex;flex-direction:column;min-width:0;transition:box-shadow .2s,transform .2s}
.card:hover{box-shadow:var(--shadow);transform:translateY(-2px)}
.ph{position:relative;aspect-ratio:4/3;background:var(--sunk);overflow:hidden;max-width:100%}
.ph img{width:100%;height:100%;object-fit:cover;display:block;cursor:zoom-in}
.nav{position:absolute;top:50%;transform:translateY(-50%);width:34px;height:34px;border-radius:50%;border:0;background:rgba(20,18,26,.55);color:#fff;cursor:pointer;display:grid;place-items:center;opacity:0;transition:opacity .15s}
.ph:hover .nav,.ph .nav:focus-visible{opacity:1}
@media (hover:none){.ph .nav{opacity:1}}
.nav.prev{left:8px}.nav.next{right:8px}
.ph .cnt{position:absolute;right:8px;bottom:8px;background:rgba(20,18,26,.62);color:#fff;font-size:12px;padding:3px 8px;border-radius:999px;font-variant-numeric:tabular-nums}
.pill{position:absolute;left:10px;top:10px;font-size:12px;font-weight:600;padding:4px 10px;border-radius:999px;background:var(--surface);color:var(--ink);box-shadow:var(--shadow)}
.pill.ok{background:var(--ok-soft);color:var(--ok)}
.body{padding:14px 16px 16px;display:flex;flex-direction:column;gap:9px;flex:1}
.loc{font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--accent)}
.card h3{font:700 18px/1.2 var(--f-display);margin:0;text-wrap:balance}
.addr{color:var(--muted);font-size:13px;margin-top:-4px}
.specs{display:flex;flex-wrap:wrap;gap:4px 14px;font-size:13px;font-variant-numeric:tabular-nums}
.specs span{display:inline-flex;align-items:center;gap:5px}
.specs svg{width:15px;height:15px;color:var(--muted)}
.lines{display:flex;flex-wrap:wrap;gap:5px;align-items:center;font-size:12px;color:var(--muted)}
.ln{width:20px;height:20px;border-radius:50%;display:inline-grid;place-items:center;font:700 11px/1 var(--f-body);color:#fff}
.ln-A{background:#18A7DE}.ln-B{background:#E1251B}.ln-C{background:#1466B8}.ln-D{background:#00885A}.ln-E{background:#7A2A8C}.ln-H{background:#F6C700;color:#1C1923}
.tags{display:flex;flex-wrap:wrap;gap:5px}
.tag{font-size:12px;padding:3px 8px;border-radius:6px;background:var(--sunk);color:var(--ink)}
.tag.pet{background:var(--warn-soft);color:var(--warn)}
.price{display:flex;align-items:baseline;gap:6px;margin-top:auto;padding-top:6px}
.price b{font:800 24px/1 var(--f-display);font-variant-numeric:tabular-nums;letter-spacing:-.01em}
.price span{font-size:13px;color:var(--muted)}
.inc{font-size:12px;color:var(--muted);margin-top:-4px}
.actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:4px}
.actions .btn{padding:9px 10px;font-size:13px}

.empty{padding:48px 16px;text-align:center;color:var(--muted)}
.empty b{display:block;font:700 20px/1.2 var(--f-display);color:var(--ink);margin-bottom:6px}

/* modal */
dialog{border:0;padding:0;border-radius:18px;background:var(--surface);color:var(--ink);width:min(980px,calc(100vw - 24px));max-height:calc(100dvh - 24px);box-shadow:0 24px 80px rgba(0,0,0,.35)}
dialog::backdrop{background:rgba(15,12,20,.6);backdrop-filter:blur(3px)}
.m-in{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);max-height:calc(100dvh - 24px)}
.m-gal{background:#111;display:flex;flex-direction:column;min-width:0}
.m-main{position:relative;flex:1;min-height:280px;display:grid;place-items:center}
.m-main .nav{width:42px;height:42px;font-size:22px}
.m-main img{max-width:100%;max-height:calc(100dvh - 140px);object-fit:contain;display:block}
.m-main .nav{opacity:1}
.m-thumbs{display:flex;gap:6px;padding:8px;overflow-x:auto;background:#111}
.m-thumbs button{flex:none;width:64px;height:48px;padding:0;border:2px solid transparent;border-radius:6px;overflow:hidden;cursor:pointer;background:none;opacity:.6}
.m-thumbs button[aria-current="true"]{border-color:#fff;opacity:1}
.m-thumbs img{width:100%;height:100%;object-fit:cover}
.m-info{padding:22px 22px 18px;overflow-y:auto;display:flex;flex-direction:column;gap:14px;min-width:0}
.m-info h2{font:800 26px/1.1 var(--f-display);margin:0;text-wrap:balance}
.m-close{position:absolute;right:12px;top:12px;z-index:3;width:38px;height:38px;border-radius:50%;border:0;background:var(--surface);color:var(--ink);font-size:20px;cursor:pointer;box-shadow:var(--shadow)}
.kv{display:grid;grid-template-columns:auto 1fr;gap:6px 14px;font-size:14px;margin:0}
.kv dt{color:var(--muted)} .kv dd{margin:0}
.m-list{margin:0;padding-left:18px;display:grid;gap:4px;font-size:14px}
.m-block h4{margin:0 0 6px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.m-price{background:var(--accent-soft);border-radius:12px;padding:14px}
.m-price b{font:800 30px/1 var(--f-display);font-variant-numeric:tabular-nums}
.m-price p{margin:6px 0 0;font-size:13px}
.m-cta{position:sticky;bottom:-18px;background:var(--surface);padding-block:10px 18px;display:flex;flex-wrap:wrap;gap:8px}
.m-cta .btn{flex:1}

/* fab + footer */
.fab{position:fixed;right:18px;bottom:calc(18px + env(safe-area-inset-bottom,0px));z-index:40;width:58px;height:58px;border-radius:50%;background:var(--wa);color:var(--wa-ink);display:grid;place-items:center;box-shadow:0 8px 24px rgba(0,0,0,.25);text-decoration:none}
.fab svg{width:30px;height:30px}
footer{margin-top:48px;border-top:1px solid var(--line);padding-block:28px 90px;color:var(--muted);font-size:14px}
footer .wrap{display:flex;flex-wrap:wrap;gap:12px 28px;justify-content:space-between;align-items:center}
footer b{color:var(--ink)}
.num{display:inline-flex;align-items:center;gap:8px}
.num code{font:600 15px var(--f-body);color:var(--ink);user-select:all}

@media (max-width:980px){.f-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.f-grid .field:first-child{grid-column:1/-1}}
@media (max-width:760px){
  .m-in{grid-template-columns:1fr;overflow-y:auto}
  .m-info{overflow:visible}
  .m-main{min-height:220px}
  .m-main img{max-height:52dvh}
  .f-toggle{display:flex}
  .filters:not(.open) .f-body{display:none}
  .brand small{display:none}
  .top .btn-wa .lbl-long{display:none}
}
@media (max-width:420px){.f-grid{grid-template-columns:1fr}.actions{grid-template-columns:1fr}}
@media (prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
</style>

