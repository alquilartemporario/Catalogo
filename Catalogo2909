            </select></div>
          <div class="field"><label for="cap">Personas</label>
            <select id="cap"><option value="">Cualquiera</option><option value="2">2 o más</option><option value="3">3 o más</option><option value="4">4</option></select></div>
          <div class="field"><label for="orden">Ordenar</label>
            <select id="orden"><option value="zona">Por zona</option><option value="asc">Menor precio</option><option value="desc">Mayor precio</option><option value="amb">Más ambientes</option><option value="m2">Más metros</option></select></div>
        </div>
        <div class="field"><span class="lbl" id="ambLbl">Ambientes</span>
