  {k:"grupos",t:"Para 3 a 4 personas",f:d=>(d.cap||0)>=3},
  {k:"uni",t:"Cerca de facultades",f:d=>/UBA|Universidad|UADE|Facultad|CBC|UCA|Barceló|Favaloro|Siglo 21|Ciudad Universitaria/i.test(d.cerca)},
  {k:"hosp",t:"Cerca de hospitales",f:d=>/Hospital|Sanatorio|Clínica/i.test(d.cerca)},
  {k:"eco",t:"Hasta USD 650",f:d=>d.mon==="USD"&&d.precio<=650},
];
const $=s=>document.querySelector(s);
const esc=s=>String(s??"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const img=(id,i)=>"data:image/webp;base64,"+IMGS[id][i];
const fmt=d=>d.mon==="USD"?"USD "+d.precio.toLocaleString("es-AR"):"$ "+d.precio.toLocaleString("es-AR");
const ambTxt=a=>a===1?"Monoambiente":a+" ambientes";
const waLink=msg=>"https://wa.me/"+WA+"?text="+encodeURIComponent(msg);
const msgFor=d=>`Hola! Me interesa el departamento de ${d.dir} (${d.barrio}) - ${ambTxt(d.amb)}, ${fmt(d)}/mes. ¿Sigue disponible?`;
const genMsg="Hola! Vi los departamentos amoblados en la web y quiero hacer una consulta.";
DATA.forEach(d=>{d.photos=IMGS[d.id].length; if(d.masc===true) d.tags.push("mascotas"); if(d.inm) d.tags.push("inmediato"); d.hay=[d.barrio,d.dir,d.titulo,d.cerca,d.z,(d.items||[]).join(" "),d.tren||"",(d.subte||[]).map(x=>"subte "+x).join(" ")].join(" ").normalize("NFD").replace(/[̀-ͯ]/g,"").toLowerCase();});

$("#topWa").href=waLink(genMsg); $("#fab").href=waLink(genMsg);

/* facts */
const usd=DATA.filter(d=>d.mon==="USD").map(d=>d.precio);
$("#facts").innerHTML=`<span><strong>${DATA.length}</strong>departamentos</span><span><strong>${new Set(DATA.map(d=>d.barrio.replace(/ (Soho|Hollywood|R|C)$/,""))).size}</strong>barrios</span><span><strong>${DATA.filter(d=>d.inm).length}</strong>con ingreso inmediato</span><span><strong>USD ${Math.min(...usd)}</strong>desde, por mes</span>`;

/* state */
const S={q:"",zona:"",precio:"",cap:"",orden:"zona",amb:"",feats:new Set(),col:""};
try{const s=JSON.parse(localStorage.getItem("at-filtros")||"null"); if(s){Object.assign(S,s); S.feats=new Set(s.feats||[]);}}catch(e){}
const save=()=>{try{localStorage.setItem("at-filtros",JSON.stringify({...S,feats:[...S.feats]}))}catch(e){}};

/* controls */
$("#zona").innerHTML='<option value="">Todas las zonas</option>'+ZONAS.map(z=>`<option>${esc(z)}</option>`).join("");
$("#chips").innerHTML=FEATS.map(([k,t])=>`<label class="chip"><input type="checkbox" value="${k}"><span class="dot"></span>${t}</label>`).join("");
$("#colRow").innerHTML=COLS.map(c=>`<button type="button" class="col-btn" data-k="${c.k}" aria-pressed="false"><span class="t">${c.t}</span><span class="n">${DATA.filter(c.f).length} deptos</span></button>`).join("");

function syncControls(){
  $("#q").value=S.q; $("#zona").value=S.zona; $("#precio").value=S.precio; $("#cap").value=S.cap; $("#orden").value=S.orden;
  document.querySelectorAll("#amb button").forEach(b=>b.setAttribute("aria-pressed",b.dataset.v===S.amb));
  document.querySelectorAll("#chips input").forEach(i=>i.checked=S.feats.has(i.value));
  document.querySelectorAll(".col-btn").forEach(b=>b.setAttribute("aria-pressed",b.dataset.k===S.col));
}
function match(d){
  if(S.q){const q=S.q.normalize("NFD").replace(/[̀-ͯ]/g,"").toLowerCase().trim(); if(q&&!q.split(/\s+/).every(w=>d.hay.includes(w))) return false;}
  if(S.zona&&d.z!==S.zona) return false;
  if(S.amb){const a=+S.amb; if(a===4? d.amb<4 : d.amb!==a) return false;}
  if(S.cap&&(d.cap||0)<+S.cap) return false;
  if(S.precio){ if(S.precio==="ARS"){ if(d.mon!=="ARS") return false;} else { const [lo,hi]=S.precio.split("-").map(Number); if(d.mon!=="USD"||d.precio<lo||d.precio>hi) return false; } }
  for(const f of S.feats) if(!d.tags.includes(f)) return false;
  if(S.col){const c=COLS.find(c=>c.k===S.col); if(c&&!c.f(d)) return false;}
  return true;
}
function sortList(L){
  const pv=d=>d.mon==="USD"?d.precio:null;
  if(S.orden==="asc"||S.orden==="desc"){const s=S.orden==="asc"?1:-1; return L.sort((a,b)=>{const x=pv(a),y=pv(b); if(x==null&&y==null) return (a.precio-b.precio)*s; if(x==null) return 1; if(y==null) return -1; return (x-y)*s;});}
  if(S.orden==="amb") return L.sort((a,b)=>b.amb-a.amb||(pv(a)??9e9)-(pv(b)??9e9));
  if(S.orden==="m2") return L.sort((a,b)=>(b.m2||0)-(a.m2||0));
  return L;
}
function card(d){
  const tagsShow=[["balcon","Balcón"],["pileta","Pileta"],["lavarropas","Lavarropas"],["cochera","Cochera"],["aire","Aire"]].filter(([k])=>d.tags.includes(k)).map(([,t])=>`<span class="tag">${t}</span>`).join("")+(d.masc===true?'<span class="tag pet">Mascotas OK</span>':"");
  const lines=(d.subte||[]).map(l=>`<span class="ln ln-${l}" title="Subte línea ${l}">${l}</span>`).join("")+(d.tren?`<span>${d.subte&&d.subte.length?"· ":""}Tren ${esc(d.tren)}</span>`:"");
  return `<article class="card" id="d-${d.id}">
    <div class="ph" data-id="${d.id}" data-i="${d.cover||0}">
      <img src="${img(d.id,d.cover||0)}" alt="${esc(d.titulo)} en ${esc(d.barrio)}" loading="lazy" data-open="${d.id}">
      <span class="pill ${d.inm?"ok":""}">${esc(d.disp)}</span>
      ${d.photos>1?`<button class="nav prev" type="button" aria-label="Foto anterior">‹</button><button class="nav next" type="button" aria-label="Foto siguiente">›</button>`:""}
      <span class="cnt"><span class="ci">${(d.cover||0)+1}</span>/${d.photos}</span>
    </div>
    <div class="body">
      <div class="loc">${esc(d.barrio)}</div>
      <h3>${esc(d.titulo)}</h3>
      <div class="addr">${esc(d.dir)}</div>
      <div class="specs">
        <span><svg><use href="#i-amb"/></svg>${ambTxt(d.amb)}</span>
        ${d.m2?`<span><svg><use href="#i-m2"/></svg>${d.m2} m²</span>`:""}
        ${d.cap?`<span><svg><use href="#i-pp"/></svg>${d.cap===1?"1 persona":"Hasta "+d.cap}</span>`:""}
      </div>
      ${lines?`<div class="lines">${lines}</div>`:""}
      <div class="tags">${tagsShow}</div>
      <div class="price"><b>${fmt(d)}</b><span>por mes</span></div>
      <div class="inc">${d.incluye?"Incluye: "+esc(d.incluye):"Gastos aparte"}</div>
      <div class="actions">
        <button class="btn btn-ghost" type="button" data-open="${d.id}">Ver detalles</button>
        <a class="btn btn-wa" href="${waLink(msgFor(d))}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><use href="#i-wa"/></svg>Consultar</a>
      </div>
    </div>
  </article>`;
}
function render(){
  const L=sortList(DATA.filter(match));
  $("#count").innerHTML=`<b>${L.length}</b> de ${DATA.length} departamentos`;
  const R=$("#results");
  const zc={}; L.forEach(d=>zc[d.z]=(zc[d.z]||0)+1);
  $("#zones").innerHTML=S.orden==="zona"?ZONAS.filter(z=>zc[z]).map(z=>`<a href="#z-${ZONAS.indexOf(z)}">${esc(z)}<span>${zc[z]}</span></a>`).join(""):"";
  if(!L.length){R.innerHTML=`<div class="empty"><b>No hay departamentos con esos filtros</b>Probá quitar alguno o escribinos por WhatsApp y te avisamos cuando se libere algo parecido.<br><br><button class="btn btn-ghost" type="button" onclick="resetAll()">Limpiar filtros</button></div>`;return;}
  if(S.orden==="zona"){
    R.innerHTML=ZONAS.filter(z=>zc[z]).map(z=>{const items=L.filter(d=>d.z===z); const barrios=[...new Set(items.map(d=>d.barrio))].join(" · ");
      return `<section class="section" id="z-${ZONAS.indexOf(z)}"><div class="sec-head"><h2>${esc(z)}</h2><p>${items.length} ${items.length===1?"departamento":"departamentos"} · ${esc(barrios)}</p></div><div class="grid">${items.map(card).join("")}</div></section>`}).join("");
  } else {
    R.innerHTML=`<section class="section"><div class="grid">${L.map(card).join("")}</div></section>`;
  }
}
function update(){save();syncControls();render();}
function resetAll(){Object.assign(S,{q:"",zona:"",precio:"",cap:"",orden:"zona",amb:"",col:""});S.feats.clear();update();}

$("#q").addEventListener("input",e=>{S.q=e.target.value;save();render();});
["zona","precio","cap","orden"].forEach(k=>$("#"+k).addEventListener("change",e=>{S[k]=e.target.value;update();}));
$("#amb").addEventListener("click",e=>{const b=e.target.closest("button");if(!b)return;S.amb=b.dataset.v;update();});
$("#chips").addEventListener("change",e=>{const i=e.target; i.checked?S.feats.add(i.value):S.feats.delete(i.value); update();});
$("#colRow").addEventListener("click",e=>{const b=e.target.closest(".col-btn");if(!b)return;S.col=S.col===b.dataset.k?"":b.dataset.k;update();$("#filters").scrollIntoView({behavior:"smooth",block:"start"});});
$("#reset").addEventListener("click",resetAll);
$("#fToggle").addEventListener("click",()=>{const f=$("#filters");f.classList.toggle("open");$("#fToggle").setAttribute("aria-expanded",f.classList.contains("open"));});
$("#copyNum").addEventListener("click",e=>{const b=e.target;const done=()=>{b.textContent="Copiado";setTimeout(()=>b.textContent="Copiar",1600)};
  try{navigator.clipboard.writeText("+5491168686694").then(done,()=>{selNum();});}catch(err){selNum();}});
function selNum(){const r=document.createRange();r.selectNodeContents(document.querySelector(".num code"));const s=getSelection();s.removeAllRanges();s.addRange(r);}

/* card carousel + open */
$("#results").addEventListener("click",e=>{
  const nav=e.target.closest(".nav");
  if(nav){const ph=nav.closest(".ph");const d=DATA.find(x=>x.id===ph.dataset.id);let i=+ph.dataset.i+(nav.classList.contains("next")?1:-1);i=(i+d.photos)%d.photos;ph.dataset.i=i;ph.querySelector("img").src=img(d.id,i);ph.querySelector(".ci").textContent=i+1;return;}
  const o=e.target.closest("[data-open]"); if(o){const ph=o.closest(".card")?.querySelector(".ph"); openD(o.dataset.open, ph?+ph.dataset.i:0);}
});

/* modal */
const dlg=$("#dlg"); let cur=null, ci=0;
function openD(id,start){
  const d=DATA.find(x=>x.id===id); if(!d) return; cur=d; ci=start??(d.cover||0);
  const lines=(d.subte||[]).map(l=>`<span class="ln ln-${l}">${l}</span>`).join(" ");
  dlg.innerHTML=`<button class="m-close" type="button" aria-label="Cerrar" id="mClose">×</button>
  <div class="m-in">
    <div class="m-gal">
      <div class="m-main"><img id="mImg" alt="Foto de ${esc(d.titulo)}">${d.photos>1?`<button class="nav prev" type="button" id="mPrev" aria-label="Foto anterior">‹</button><button class="nav next" type="button" id="mNext" aria-label="Foto siguiente">›</button>`:""}</div>
      <div class="m-thumbs" id="mThumbs">${IMGS[d.id].map((_,i)=>`<button type="button" data-i="${i}" aria-label="Foto ${i+1}"><img src="${img(d.id,i)}" alt=""></button>`).join("")}</div>
    </div>
    <div class="m-info">
      <div><div class="loc">${esc(d.barrio)}${d.z!==d.barrio?" · "+esc(d.z):""}</div><h2 id="mTitle">${esc(d.titulo)}</h2><div class="addr" style="margin-top:4px">${esc(d.dir)}</div></div>
      <div class="m-price"><b>${fmt(d)}</b> <span>por mes</span>
        ${d.incluye?`<p><strong>Incluye:</strong> ${esc(d.incluye)}</p>`:""}
        ${d.cargo?`<p><strong>A cargo del inquilino:</strong> ${esc(d.cargo)}</p>`:""}</div>
      <dl class="kv">
        <dt>Disponibilidad</dt><dd>${esc(d.disp)}</dd>
        <dt>Tipo</dt><dd>${ambTxt(d.amb)}${d.m2?" · "+d.m2+" m²":""}</dd>
        ${d.cap?`<dt>Capacidad</dt><dd>${d.cap===1?"1 persona":"Hasta "+d.cap+" personas"}</dd>`:""}
        <dt>Mascotas</dt><dd>${d.masc===true?"Sí (consultar condiciones)":d.masc===false?"No":"Consultar"}</dd>
        ${(d.subte&&d.subte.length)||d.tren?`<dt>Transporte</dt><dd>${lines}${d.tren?(lines?" · ":"")+"Tren "+esc(d.tren):""}</dd>`:""}
        ${d.cond?`<dt>Contrato</dt><dd>${esc(d.cond)}</dd>`:""}
      </dl>
      <div class="m-block"><h4>El departamento</h4><ul class="m-list">${d.items.map(i=>`<li>${esc(i)}</li>`).join("")}</ul></div>
      <div class="m-block"><h4>Cerca</h4><div style="font-size:14px">${esc(d.cerca)}</div></div>
      <div class="m-block"><h4>Requisitos</h4><div style="font-size:14px">${esc(d.req)}</div></div>
      <div class="m-cta">
        <a class="btn btn-wa" href="${waLink(msgFor(d))}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><use href="#i-wa"/></svg>Consultar por WhatsApp</a>
        ${d.video?`<a class="btn btn-ghost" href="${d.video}" target="_blank" rel="noopener">Ver video</a>`:`<a class="btn btn-ghost" href="${waLink("Hola! ¿Me podés enviar el video del departamento de "+d.dir+"?")}" target="_blank" rel="noopener">Pedir video</a>`}
      </div>
    </div>
  </div>`;
  showI(ci);
  $("#mClose").onclick=()=>dlg.close();
  if(d.photos>1){$("#mPrev").onclick=()=>showI(ci-1);$("#mNext").onclick=()=>showI(ci+1);}
  $("#mThumbs").onclick=e=>{const b=e.target.closest("button");if(b)showI(+b.dataset.i);};
  if(!dlg.open) dlg.showModal();
}
function showI(i){const n=cur.photos;ci=(i+n)%n;$("#mImg").src=img(cur.id,ci);document.querySelectorAll("#mThumbs button").forEach((b,j)=>{b.setAttribute("aria-current",j===ci);if(j===ci)b.scrollIntoView({block:"nearest",inline:"nearest"});});}
dlg.addEventListener("click",e=>{if(e.target===dlg)dlg.close();});
document.addEventListener("keydown",e=>{if(!dlg.open)return;if(e.key==="ArrowRight")showI(ci+1);if(e.key==="ArrowLeft")showI(ci-1);});

syncControls(); render();
const h=location.hash.slice(1); if(h.startsWith("d-")) openD(h.slice(2));
</script>

</body></html>
