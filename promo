<script>
/* ====== CONFIGURACIÓN ====== */
const CSV_URL="https://docs.google.com/spreadsheets/d/e/2PACX-1vQ2E7ECUfY-ps4Ok0_1TJxTR1UPoYl-_ZYkGNlvhk9eZWHBslhsWtoCiTaPfCjQJ38kojq9pJBeoGep/pub?output=csv";
const WA_GENERAL="5491168686694";
const ARMADO_CONTRATO="USD 400"; // si la planilla tiene una columna "Armado", se usa ese valor
/* =========================== */
function cel(r,n){const k=Object.keys(r).find(k=>k.trim().toLowerCase()===n.toLowerCase());return k?String(r[k]||"").trim():""}
function esSi(v){return ["si","sí","yes","true","1","x"].includes(String(v).trim().toLowerCase())}
function slug(v){return String(v||"").normalize("NFD").replace(/[̀-ͯ]/g,"").toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/^-+|-+$/g,"")}
function esc(v){return String(v||"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function fotos(r){const out=[];["Fotos","Fotos2","Fotos3"].forEach(c=>{(cel(r,c).match(/https?:\/\/[^\s\])"',]+/g)||[]).forEach(u=>{const m=u.match(/[?&]id=([\w-]+)/)||u.match(/\/file\/d\/([\w-]+)/)||u.match(/\/d\/([\w-]+)/);const f=m?"https://drive.google.com/thumbnail?id="+m[1]+"&sz=w1600":u;if(!out.includes(f))out.push(f)})});return out}
function amb(v){const m=String(v).match(/\d+/);return m?(m[0]==="1"?"1 ambiente":m[0]+" ambientes"):""}
const slugBuscado=new URLSearchParams(location.search).get("d")||"";
Papa.parse(CSV_URL,{download:true,header:true,skipEmptyLines:true,complete:function(res){
  const rows=res.data.filter(r=>cel(r,"Dirección"));
  const r=rows.find(x=>slug(cel(x,"Dirección"))===slugBuscado);
  if(!r){document.getElementById('app').innerHTML='<div class="load"><div><h2>No encontramos ese departamento</h2><p class="lead" style="margin:0 auto 24px">Puede que ya se haya alquilado.</p><a class="btn btn-acc" href="promos.html">Ver deptos en promo</a></div></div>';return}
  render(r);
},error:function(){document.getElementById('app').innerHTML='<div class="load">No se pudo cargar el departamento. Probá de nuevo en un momento.</div>'}});

function render(r){
  const dir=cel(r,"Dirección"),barrio=cel(r,"barrio")||"Buenos Aires",ambT=amb(cel(r,"Ambientes")),valor=cel(r,"Valor:"),incl=cel(r,"Incluye");
  const desc=cel(r,"descripcion")||cel(r,"descripción")||incl;const promo=esSi(cel(r,"PROMO"));
  const arm=cel(r,"Armado")||ARMADO_CONTRATO;const tel=(cel(r,"Vendedor").replace(/\D/g,""))||WA_GENERAL;const F=fotos(r);
  const perro=esSi(cel(r,"perro?")),gato=esSi(cel(r,"gato?"));
  document.title=(ambT||"Depto")+" en "+barrio+" · "+dir+" | Alquilar Temporario";
  const wa=m=>"https://wa.me/"+tel+"?text="+encodeURIComponent(m);
  const wv=wa("¡Hola! Vi el depto de "+dir+" ("+barrio+") con la promo de solo el armado del contrato. ¿Puedo coordinar una visita?");
  const wr=wa("¡Hola! Quiero reservar el depto de "+dir+" ("+barrio+") con la promo de solo el armado del contrato. ¿Qué necesito?");
  const ico='<svg viewBox="0 0 24 24" fill="currentColor"><use href="#wa"/></svg>';
  const maps="https://www.google.com/maps/search/?api=1&query="+encodeURIComponent(dir+", "+barrio+", Buenos Aires");
  const gal=F.slice(0,7).map((f,i)=>'<button data-i="'+i+'" class="'+(i===0?'big':'')+'"><img loading="lazy" src="'+esc(f)+'" alt="Foto '+(i+1)+'"></button>').join("")+(F.length>7?'<button data-i="7" class="more">+'+(F.length-7)+' fotos</button>':'');
  document.getElementById('app').innerHTML=`
<header class="hero"><div class="hero-bg" style="background-image:url('${esc(F[0]||"")}')"></div><div class="wrap">
<span class="pill"><i></i>Alquiler temporario · ${esc(barrio)}</span>
<h1>Tu depto en ${esc(barrio)}, <span>listo para entrar.</span></h1>
<p class="sub">${esc(ambT?ambT+" amoblado y equipado":"Departamento amoblado y equipado")} en ${esc(dir)}.</p>
<div class="chips">${promo?'<span class="chip acc">Promo de ingreso</span>':''}${ambT?'<span class="chip">'+esc(ambT)+'</span>':''}<span class="chip">📍 ${esc(dir)}</span>${valor?'<span class="chip">'+esc(valor)+'</span>':''}</div>
<div class="row-btn"><a class="btn btn-wa" href="${wv}" target="_blank" rel="noopener">${ico}Coordinar visita</a><a class="btn btn-ghost" href="#fotos">Ver fotos</a></div>
<div class="ribbon">🔥 Para entrar <b>&nbsp;solo pagás el armado del contrato</b></div>
</div></header>
<div class="wrap"><div class="facts">
<div class="fact"><b>${esc(ambT||"Amoblado")}</b><span>${esc(barrio)}</span></div>
<div class="fact"><b>${esc(valor||"Consultar")}</b><span>valor</span></div>
<div class="fact"><b>${esc(arm)}</b><span>armado de contrato</span></div>
<div class="fact"><b>3 a 12</b><span>meses de contrato</span></div></div></div>
<section id="fotos"><div class="wrap"><div class="center"><span class="kicker">El departamento</span><h2>Conocelo <em>por dentro.</em></h2><p class="lead">Tocá cada foto para verla grande.</p></div>
<div class="gallery" id="gal">${gal||'<p class="lead center" style="grid-column:1/-1">Pedinos las fotos por WhatsApp.</p>'}</div>
<div class="info"><div class="box"><h3>Lo que tenés que saber</h3><div class="desc">${esc(desc||"Escribinos y te contamos todos los detalles.")}</div>${(perro||gato)?'<div class="pets">'+(perro?'<span>🐶 Acepta perro</span>':'')+(gato?'<span>🐱 Acepta gato</span>':'')+'</div>':''}</div>
<div class="box loc"><h3>Ubicación</h3><p>📍 ${esc(dir)}</p><small>${esc(barrio)}, Buenos Aires</small><a class="btn btn-ghost" href="${maps}" target="_blank" rel="noopener">Abrir en Google Maps</a><div style="height:12px"></div><a class="btn btn-wa" href="${wv}" target="_blank" rel="noopener">${ico}Quiero verlo</a></div></div>
</div><div class="next"><a href="#ahorro"><span class="ar">↓</span><span>Ahora lo mejor: <b>cuánto te ahorrás al entrar</b></span></a></div></section>
