@keyframes kb{to{transform:scale(1.14)}}
.hero::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(12,11,16,.45),rgba(12,11,16,.35) 30%,rgba(12,11,16,.88) 68%,var(--bg))}
.hero .wrap{position:relative;z-index:2}
.pill{display:inline-flex;align-items:center;gap:10px;background:rgba(15,13,20,.6);backdrop-filter:blur(8px);border:1px solid var(--line);padding:8px 16px;border-radius:999px;font-size:13px;font-weight:500;letter-spacing:.06em;text-transform:uppercase}.pill i{width:8px;height:8px;border-radius:50%;background:var(--acc)}
.hero h1{font-size:clamp(38px,7.5vw,80px);font-weight:800;margin:20px 0 14px;max-width:900px}.hero h1 span{color:var(--acc)}
