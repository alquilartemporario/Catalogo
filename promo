.hint i::after{content:"";position:absolute;left:50%;top:8px;width:4px;height:8px;margin-left:-2px;border-radius:2px;background:var(--acc);animation:wh 1.6s infinite}
@keyframes wh{0%{opacity:0}30%{opacity:1}100%{opacity:0;transform:translateY(14px)}}
.facts{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;margin-top:-30px;position:relative;z-index:3}
.fact{background:var(--bg2);padding:20px}.fact b{display:block;font-size:22px;font-weight:800;color:var(--acc);line-height:1.15}.fact span{font-size:14px;color:var(--mut)}
