.btn-ghost{background:rgba(255,255,255,.08);color:#fff;border:1px solid var(--line)}
.prog{position:fixed;top:0;left:0;height:3px;width:0;background:linear-gradient(90deg,var(--acc),var(--acc2));z-index:70}
.nav{position:sticky;top:0;z-index:50;background:rgba(12,11,16,.8);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;gap:12px;height:62px}
.brand{display:flex;align-items:center;gap:10px;font-weight:700}.brand i{width:30px;height:30px;border-radius:9px;background:var(--acc);display:grid;place-items:center;color:#16120a;font-style:normal;font-weight:800;font-size:14px}
.nav .btn{padding:10px 18px;font-size:14px}.back{color:var(--mut);font-size:14px}
.hero{position:relative;min-height:min(88vh,820px);display:flex;align-items:flex-end;padding:0 0 100px;overflow:hidden}
