.info{display:grid;grid-template-columns:1.2fr 1fr;gap:22px;margin-top:34px;align-items:start}
.box{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:28px}
.box h3{font-size:14px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--acc);margin-bottom:14px}
.desc{white-space:pre-wrap;color:#dcd8e6;font-size:16px}
.pets{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}.pets span{background:rgba(255,255,255,.07);border:1px solid var(--line);padding:7px 13px;border-radius:999px;font-size:14px}
.loc p{font-size:19px;font-weight:600;margin-bottom:6px}.loc small{color:var(--mut);display:block;margin-bottom:18px}
.save{background:linear-gradient(180deg,var(--bg),#161124)}
.compare{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:36px;text-align:left}
.cbox{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:28px;position:relative}
.cbox h3{font-size:14px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--mut);margin-bottom:16px}
.cbox.win{background:linear-gradient(160deg,#2a2140,#1b1628);border:1.5px solid var(--acc)}.cbox.win h3{color:var(--acc)}
.tag{position:absolute;top:-13px;right:20px;background:var(--acc);color:#16120a;font-weight:800;font-size:12px;padding:6px 13px;border-radius:999px}
.li{display:flex;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px dashed var(--line);font-size:16px}.li:last-child{border:0}
.li small{display:block;color:var(--mut);font-size:13px}.li>span:last-child{white-space:nowrap;text-align:right;font-weight:600}
.li s{color:#8d879c}.free{display:block;color:var(--ok);font-weight:700}
.big-save{margin:34px auto 0;max-width:780px;background:var(--acc);color:#16120a;border-radius:var(--r);padding:28px 24px;text-align:center}
.big-save strong{display:block;font-size:clamp(26px,4.5vw,40px);font-weight:800;line-height:1.1;margin:4px 0 6px}
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:36px;counter-reset:s;text-align:left}
.step{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:26px;counter-increment:s}
.step::before{content:counter(s);display:grid;place-items:center;width:42px;height:42px;border-radius:50%;background:var(--acc);color:#16120a;font-weight:800;margin-bottom:14px}
.step b{font-size:18px;display:block;margin-bottom:6px}.step p{color:var(--mut);font-size:15px}
.req{margin-top:20px;display:flex;flex-wrap:wrap;gap:10px;justify-content:center}.req span{background:rgba(255,255,255,.06);border:1px solid var(--line);padding:9px 16px;border-radius:999px;font-size:14px}
.next{display:flex;justify-content:center;padding:44px 16px 0}
.next a{display:inline-flex;align-items:center;gap:12px;padding:12px 20px 12px 14px;border-radius:999px;background:rgba(245,184,65,.1);border:1px solid rgba(245,184,65,.35);font-size:15px;font-weight:600}
.next b{color:var(--acc)}.next .ar{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--acc);color:#16120a;animation:nd 1.5s infinite}
@keyframes nd{50%{transform:translateY(4px)}}
.final{text-align:center;padding:100px 0 120px;background:linear-gradient(180deg,var(--bg),#1b1430)}
footer{padding:28px 0 110px;text-align:center;color:#7d7890;font-size:13px;border-top:1px solid var(--line)}
.mbar{display:none}
.load{min-height:70vh;display:grid;place-items:center;color:var(--mut);text-align:center;padding:40px}
@media(max-width:900px){section{padding:60px 0}.facts{grid-template-columns:repeat(2,1fr)}.info,.compare,.steps{grid-template-columns:1fr}.gallery{grid-template-columns:repeat(2,1fr);grid-auto-rows:160px}
.mbar{display:flex;gap:10px;position:fixed;left:0;right:0;bottom:0;z-index:60;padding:10px 12px calc(10px + env(safe-area-inset-bottom));background:rgba(12,11,16,.92);backdrop-filter:blur(10px);border-top:1px solid var(--line)}.mbar .btn{flex:1;padding:14px 10px;font-size:15px}.hint,.back{display:none}}
@media(prefers-reduced-motion:reduce){*{animation:none!important}}
