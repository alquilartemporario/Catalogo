const bundledPhotoData={"1ovHNGR9hNngUED7OAvrLJor9RZ7WAOd9":"data:image/jpeg;base64,","1PmFVw5OdK0uLUvpp30yOnR73rcoVHCx9":"data:image/jpeg;base64,","1RTkVKA8XhtfbZrznpwqenhH1NZBjvXM4":"data:image/jpeg;base64,","1aNW-2k9iqjW7yKtlsIpirFQw767tObjg":"data:image/jpeg;base64,","1-JhvXY45diMgu4pF6upXuQxo1lXyw-FU":"data:image/jpeg;base64,","1SFy89xU8Ad5WRq9lnilCQiAOELQk1wms":"data:image/jpeg;base64,","1pOR2iDZJxTCUBzTtNjawUXB8xi8q8NpA":"data:image/jpeg;base64,","1y3-204fAkSU2J0eiMWw5bMGQakeUfq9A":"data:image/jpeg;base64,","1x2XR_VesOl2jJuwJRRISP1X2BMCZGCoh":"data:image/jpeg;base64,"};
const bundledPhotos = new Set(Object.keys(bundledPhotoData));
function bindImageFallbacks(root=document) {
 root.querySelectorAll('img[data-photo-src]').forEach(img => {
  img.onerror=()=> {
   const id=img.dataset.photoId;
   const stage=Number(img.dataset.stage || 0);
   if(id && stage===0) { img.dataset.stage='1';img.src=`https://drive.google.com/thumbnail?id=${encodeURIComponent(id)}&sz=w1200`; }
   else if(id && bundledPhotos.has(id) && stage<2) { img.dataset.stage='2';img.src=bundledPhotoData[id]; }
   else { const fallback=document.createElement('div');fallback.className='photo-unavailable';fallback.innerHTML=`${icon('photos')}Foto no disponible`;img.replaceWith(fallback); }
  };
  if (img.complete && !img.naturalWidth) img.onerror();
 });
}
function syncSelects() {
 const prevN=state.filters.neighborhood,prevR=state.filters.rooms;
 const neighborhoods=[...new Set(state.properties.map(p=>p.neighborhood))].sort((a,b)=>a.localeCompare(b,'es'));
 const rooms=[...new Set(state.properties.map(p=>p.rooms).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'es',{numeric:true}));
 $('#neighborhood').innerHTML='<option value="">Todos los barrios</option>'+neighborhoods.map(n=>`<option value="${esc(n)}">${esc(titleCase(n))}</option>`).join('');
 $('#rooms').innerHTML='<option value="">Todos los ambientes</option>'+rooms.map(r=>`<option value="${esc(r)}">${esc(r)} ${r==='1'?'ambiente':'ambientes'}</option>`).join('');
 state.filters.neighborhood=neighborhoods.includes(prevN)?prevN:'';state.filters.rooms=rooms.includes(prevR)?prevR:'';
 $('#neighborhood').value=state.filters.neighborhood;$('#rooms').value=state.filters.rooms;
}
function render() {
 const rows=selectProperties(state.properties,state.filters);
 $('#properties').innerHTML=rows.slice(0,state.limit).map(card).join('');
 $('#properties').hidden=!rows.length;$('#empty').hidden=!!rows.length;$('#load-more').hidden=rows.length<=state.limit;
 $('#result-count').textContent=`${rows.length} ${rows.length===1?'departamento encontrado':'departamentos encontrados'}`;
 for(const pet of ['all','dog','cat','both']) $('#count-'+pet).textContent=selectProperties(state.properties,{pet}).length;
 document.querySelectorAll('[data-pet]').forEach(b=>{const active=b.dataset.pet===state.filters.pet;b.classList.toggle('active',active);b.setAttribute('aria-pressed',String(active));});
 const both=selectProperties(state.properties,{pet:'both'});
 $('#both-total').textContent=both.length;
 $('#together-properties').innerHTML=both.length ? both.slice(0,3).map(card).join('') : '<p class="muted">Por ahora no hay opciones marcadas para ambas especies. Revisá las otras alternativas o volvé a consultar más adelante.</p>';
 $('#see-both').hidden=!both.length;
 bindImageFallbacks();
 const query=new URLSearchParams(location.search);
 for(const key of ['pet','neighborhood','rooms','sort']) { if(state.filters[key] && !['all','sheet'].includes(state.filters[key])) query.set(key,state.filters[key]);else query.delete(key); }
 safeReplaceState(null,'',`${location.pathname}${query.size?'?'+query:''}${location.hash}`);
 if(state.detail) {
  if(!state.properties.some(p=>p.id===state.detail)){ $('#detail-modal').close();state.detail=null;toast('Esta opción ya no figura entre los departamentos aptos para mascotas.'); }
  else if($('#detail-modal').open) renderDetail();
 }
 if(state.inquiry && !state.properties.some(p=>p.id===state.inquiry)){ $('#inquiry-modal').close();state.inquiry=null;toast('Esta opción ya no figura disponible en este catálogo. Elegí otra unidad.'); }
}
function setSync(live, time, error='') {
 state.live=live;state.fetchedAt=time;
 $('#sync-status').textContent=live?`Catálogo consultado · ${new Date(time).toLocaleTimeString('es-AR',{hour:'2-digit',minute:'2-digit'})}`:'No se pudo actualizar';
 $('#sync-status').previousElementSibling.style.background=live?'#62855e':'#c38b4c';
 $('#data-alert').hidden=live;
 $('#data-alert').textContent=state.properties.length ? `No pudimos actualizar en este momento. Estás viendo una copia del ${formatDate(time)}. Confirmá precios y disponibilidad por WhatsApp.` : `No pudimos cargar el catálogo. Revisá tu conexión y tocá el botón de actualizar. ${error}`;
}
async function refresh(manual=false) {
 if(state.busy)return;
 state.busy=true;$('#refresh').disabled=true;
 try {
  const response=await fetch(`${SOURCE_URL}&_=${Date.now()}`,{cache:'no-store',signal:AbortSignal.timeout(25000)});
  if(!response.ok)throw new Error('Respuesta del catálogo no disponible.');
  const raw=parseCSV(await response.text());
  state.properties=normalizeRows(raw);const time=Date.now();
  try {localStorage.setItem(CACHE_KEY,JSON.stringify({properties:state.properties,fetchedAt:time}));} catch {}
  syncSelects();render();setSync(true,time);
  if(manual)toast('Catálogo actualizado.');
 }catch(error){
  if(!state.properties.length && !state.fetchedAt){
   try {const snapshot=FALLBACK_SNAPSHOT;state.properties=snapshot.properties;state.fetchedAt=snapshot.fetchedAt;syncSelects();render();}catch{render();}
  }
  setSync(false,state.fetchedAt || Date.now());
  if(manual)toast('No pudimos actualizar. Intentá de nuevo en unos minutos.');
 }finally{state.busy=false;$('#refresh').disabled=false;}
}
function reset() {state.filters={pet:'all',neighborhood:'',rooms:'',sort:'sheet'};state.limit=6;$('#neighborhood').value='';$('#rooms').value='';$('#sort').value='sheet';render();}
function setPet(pet) {state.filters.pet=pet;state.limit=6;render();}
document.querySelectorAll('[data-pet]').forEach(b=>b.addEventListener('click',()=>setPet(b.dataset.pet)));
$('#neighborhood').addEventListener('change',e=>{state.filters.neighborhood=e.target.value;state.limit=6;render();});
$('#rooms').addEventListener('change',e=>{state.filters.rooms=e.target.value;state.limit=6;render();});
$('#sort').addEventListener('change',e=>{state.filters.sort=e.target.value;state.limit=6;render();});
$('#clear').addEventListener('click',reset);$('#empty-clear').addEventListener('click',reset);
$('#load-more').addEventListener('click',()=>{state.limit+=6;render();});
$('#refresh').addEventListener('click',()=>refresh(true));
$('#see-both').addEventListener('click',()=>{reset();setPet('both');$('#departamentos').scrollIntoView({behavior:'smooth'});});
document.addEventListener('click',e=>{const detail=e.target.closest('[data-detail]'),inquiry=e.target.closest('[data-inquiry]');if(detail)openDetail(detail.dataset.detail);if(inquiry)openInquiry(inquiry.dataset.inquiry);});
function renderDetail() {
 const p=state.properties.find(p=>p.id===state.detail);if(!p)return;
 state.photo=Math.min(state.photo,Math.max(0,p.photos.length-1));
 $('#detail-content').innerHTML=`<div class="gallery">${photoHTML(p,state.photo,true)}${p.photos.length>1?'<button class="gallery-button prev" id="gallery-prev" aria-label="Foto anterior">‹</button><button class="gallery-button next" id="gallery-next" aria-label="Foto siguiente">›</button>':''}${p.photos.length?`<span class="gallery-counter">${state.photo+1} / ${p.photos.length}</span>`:''}</div>${p.photos.length>1?`<div class="gallery-thumbs" aria-label="Elegir foto">${p.photos.map((_,i)=>`<button data-photo="${i}" class="${state.photo===i?'active':''}" aria-label="Ver foto ${i+1}" aria-pressed="${state.photo===i}">${photoHTML(p,i)}</button>`).join('')}</div>`:''}<div class="detail-body"><div class="detail-top"><div><p class="eyebrow">${esc(p.neighborhood)} · ${esc(p.rooms)} AMBIENTES</p><h2>${esc(p.address)}</h2></div><div class="card-price">${price(p)}<small>/ mes${p.price.currency==='ARS'?' · ARS':''}</small></div></div><div class="pet-badges">${badge(p)}</div><p class="pet-condition">${esc(p.conditions)}</p><div class="detail-data"><div><strong>Valor publicado</strong>${esc(p.price.raw || 'A consultar')}</div><div><strong>Gastos y detalles</strong>${esc(p.includes || 'A confirmar al consultar')}</div></div>${p.dog&&p.cat?'<p class="detail-note">Acepta ambas especies según el catálogo. Si vas con perro y gato a la vez, confirmá la cantidad, el tamaño y la convivencia antes de reservar.</p>':''}<div class="detail-description">${esc(p.description || 'Consultá la descripción completa con el asesor.')}</div><p class="detail-note">Disponibilidad, requisitos y condiciones de mascotas sujetos a confirmación.${!state.live?' Estás viendo una copia guardada; pedí los valores actuales.':''}</p><div class="detail-actions"><button class="button primary" data-inquiry="${esc(p.id)}">${icon('chat')}Consultar por WhatsApp</button><a class="button outline" href="https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${p.address}, ${p.neighborhood}, Buenos Aires, Argentina`)}" target="_blank" rel="noopener noreferrer">${icon('pin')}Ver ubicación ↗</a><button id="share-property" class="button outline">Compartir ↗</button></div></div>`;
 bindImageFallbacks($('#detail-content'));
 $('#gallery-prev')?.addEventListener('click',()=>movePhoto(-1));$('#gallery-next')?.addEventListener('click',()=>movePhoto(1));
 $('#detail-content').querySelectorAll('[data-photo]').forEach(b=>b.addEventListener('click',()=>{state.photo=Number(b.dataset.photo);renderDetail();}));
 $('#share-property').addEventListener('click',async()=>{
  const url=new URL(location.href);url.searchParams.set('property',p.id);url.hash='departamentos';
  try{if(navigator.share)await navigator.share({title:`${p.address} · Apto mascotas`,url:url.href});else{await navigator.clipboard.writeText(url.href);toast('Enlace copiado.');}}catch(e){if(e.name!=='AbortError')toast('Copiá el enlace de la barra de direcciones para compartir.');}
 });
}
function openDetail(id){state.detail=id;state.photo=0;const url=new URL(location.href);url.searchParams.set('property',id);safeReplaceState(null,'',url);renderDetail();if(!$('#detail-modal').open)$('#detail-modal').showModal();}
function movePhoto(delta){const p=state.properties.find(p=>p.id===state.detail);if(p?.photos.length){state.photo=(state.photo+delta+p.photos.length)%p.photos.length;renderDetail();}}
$('#close-detail').addEventListener('click',()=>$('#detail-modal').close());
$('#detail-modal').addEventListener('close',()=>{state.detail=null;const url=new URL(location.href);url.searchParams.delete('property');safeReplaceState(null,'',url);});
$('#detail-modal').addEventListener('keydown',e=>{if(e.key==='ArrowRight')movePhoto(1);if(e.key==='ArrowLeft')movePhoto(-1);});
function openInquiry(id){
 const p=state.properties.find(p=>p.id===id);if(!p)return;
 state.inquiry=id;$('#inquiry-property').textContent=`${p.address} · ${titleCase(p.neighborhood)} · ${p.rooms} amb.`;
 const select=$('#inquiry-form').elements.pet;
 const options=[...(p.dog?[['Perro','Perro']]:[]),...(p.cat?[['Gato','Gato']]:[]),...(p.dog&&p.cat?[['Perro y gato','Perro y gato']]:[])];
 select.innerHTML=options.map(([v,t])=>`<option value="${v}">${t}</option>`).join('');
 select.value=state.filters.pet==='both'&&p.dog&&p.cat?'Perro y gato':state.filters.pet==='cat'&&p.cat?'Gato':options[0][0];
 $('#inquiry-form').elements.date.min=new Date(Date.now()-new Date().getTimezoneOffset()*60000).toISOString().slice(0,10);
 if(!$('#inquiry-modal').open)$('#inquiry-modal').showModal();
}
$('#close-inquiry').addEventListener('click',()=>$('#inquiry-modal').close());
$('#inquiry-modal').addEventListener('close',()=>state.inquiry=null);
for(const dialog of document.querySelectorAll('dialog'))dialog.addEventListener('click',e=>{if(e.target===dialog){const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close();}});
$('#inquiry-form').addEventListener('submit',e=>{
 e.preventDefault();const p=state.properties.find(p=>p.id===state.inquiry);if(!p)return toast('Esta opción ya no está en el catálogo.');
 const values=Object.fromEntries(new FormData(e.target));values.name=values.name.trim();values.notes=values.notes.trim();
 if(!values.name){e.target.elements.name.focus();return;}
 const text=inquiryMessage(p,values);
 const link=document.createElement('a');link.href=`https://wa.me/${sellerPhone(p)}?text=${encodeURIComponent(text)}`;link.target='_blank';link.rel='noopener noreferrer';document.body.append(link);link.click();link.remove();
});
const params=new URLSearchParams(location.search);
for(const key of ['pet','neighborhood','rooms','sort'])if(params.has(key))state.filters[key]=params.get(key);
if(!['all','dog','cat','both'].includes(state.filters.pet))state.filters.pet='all';
if(!['sheet','price-asc','price-desc'].includes(state.filters.sort))state.filters.sort='sheet';
$('#sort').value=state.filters.sort;
if(cache && Array.isArray(cache.properties)&&cache.fetchedAt){state.properties=cache.properties;state.fetchedAt=cache.fetchedAt;syncSelects();render();$('#data-alert').hidden=false;$('#data-alert').textContent=`Comprobando novedades. Copia guardada del ${formatDate(cache.fetchedAt)}.`;}
await refresh();
if(params.get('property')){if(state.properties.some(p=>p.id===params.get('property')))openDetail(params.get('property'));else toast('La unidad compartida ya no figura en este catálogo.');}
setInterval(()=>{if(!document.hidden)refresh();},180000);
document.addEventListener('visibilitychange',()=>{if(!document.hidden && Date.now()-(state.fetchedAt||0)>180000)refresh();});
window.addEventListener('online',()=>refresh());

</script>
